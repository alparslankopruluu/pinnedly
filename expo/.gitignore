# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local
.env

# Firebase config (download from console)
google-services.json
GoogleService-Info.plist

*.jks

# typescript
*.tsbuildinfo
.vercel

# Fastlane generated reports
fastlane/README.md
fastlane/report.xml

# iOS native project is committed for Xcode Cloud. Keep only generated,
# machine-specific, and dependency artifacts out of version control.
ios/Pods/
ios/build/
ios/DerivedData/
ios/.xcode.env.local
ios/**/*.xcuserdata/
ios/**/*.xcuserstate
!ios/Draft/GoogleService-Info.plist
android/
core
node_modules
.expo
